{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main app window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    "window-state:default",
    "shell:allow-execute",
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "find-exe",
          "cmd": "where",
          "args": true
        },
        {
          "name": "list-programs",
          "cmd": "wmic",
          "args": true
        }
      ]
    }
  ]
}